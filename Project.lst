				; traverse 11 rows of tempArray, find highest temp per row, set current dailyHighs index with valuem, if counter is 11/>10 (end of current row),
				; increase counter for dailyHighs array, reset tempArray counter to 11. Keep going until last tempArray element is seen. Find highest 14 temps.
 0000007D			findDailyHighs PROC
 0000007D  55				push	ebp
 0000007E  8B EC			mov		ebp, esp

 00000080  8B 75 08			mov		esi, [ebp+8]	; tempArray address
 00000083  8B 5D 0C			mov		ebx, [ebp+12]	; dailyHighs address
 00000086  BA 00000000			mov		edx, 0			; day counter (0 to DAYS_MEASURED - 1)

 0000008B				_dayRowLoop:
 0000008B  83 FA 0E				cmp		edx, DAYS_MEASURED
 0000008E  74 26				je		_finished

 00000090  B8 00000014				mov		eax, MIN_TEMP	; start at min temp '20' to only ever get highest temps
 00000095  B9 00000000				mov		ecx, 0

 0000009A					_tempColumnLoop:
 0000009A  83 F9 0B					cmp		ecx, TEMPS_PER_DAY
 0000009D  74 0E					je		_rowFinished

 0000009F  3B 04 8E					cmp		eax, [esi + ecx * 4]
 000000A2  7C 03					jl		_setNewHigh

 000000A4  41						inc		ecx
 000000A5  EB F3					jmp		_tempColumnLoop

 000000A7					_setNewHigh:
 000000A7  8B 04 8E					mov		eax, [esi + ecx * 4]
 000000AA  41						inc		ecx
 000000AB  EB ED					jmp		_tempColumnLoop

 000000AD					_rowFinished:
 000000AD  89 04 93					mov		[ebx + edx * 4], eax
 000000B0  83 C6 2C					add		esi, TEMPS_PER_DAY * 4
 000000B3  42						inc		edx
 000000B4  EB D5					jmp		_dayRowLoop
 000000B6				_finished:
 000000B6  5D					pop		ebp
 000000B7  C2 0008				ret		8
 000000BA			findDailyHighs ENDP

 000000BA			findDailyLows PROC
 000000BA  55				push	ebp
 000000BB  8B EC			mov		ebp, esp

 000000BD  8B 75 08			mov		esi, [ebp+8]	; tempArray base address
 000000C0  8B 5D 0C			mov		ebx, [ebp+12]	; dailyLows base address
 000000C3  BA 00000000			mov		edx, 0			; day counter (0 to DAYS_MEASURED - 1)

 000000C8				_dayRowLoop:
 000000C8  83 FA 0E				cmp		edx, DAYS_MEASURED
 000000CB  74 26				je		_finished
						
 000000CD  B8 00000050				mov		eax, MAX_TEMP	; start at max tmep '80' to only ever get lowest temps
 000000D2  B9 00000000				mov		ecx, 0			

 000000D7					_tempColumnLoop:
 000000D7  83 F9 0B					cmp		ecx, TEMPS_PER_DAY
 000000DA  74 0E					je		_rowFinished

 000000DC  3B 04 8E					cmp		eax, [esi + ecx * 4]
 000000DF  7F 03					jg		_setNewLow	

 000000E1  41						inc		ecx
 000000E2  EB F3					jmp		_tempColumnLoop

 000000E4					_setNewLow:
 000000E4  8B 04 8E					mov		eax, [esi + ecx * 4]
 000000E7  41						inc		ecx
 000000E8  EB ED					jmp		_tempColumnLoop

 000000EA					_rowFinished:
 000000EA  89 04 93				mov		[ebx + edx * 4], eax  ; Saves the definitive lowest temp
 000000ED  83 C6 2C				add		esi, TEMPS_PER_DAY * 4
 000000F0  42					inc		edx
 000000F1  EB D5				jmp		_dayRowLoop

 000000F3				_finished:
